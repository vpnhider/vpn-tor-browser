# WireGuard VPN Configuration
# Get these from your VPN provider (ProtonVPN, Mullvad, etc.)
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_PEER_PUBLIC_KEY=peer_public_key_here
WIREGUARD_ENDPOINT=vpn.server.ip:51820

# SERVER_PUBLIC_IP is now optional - auto-detected at runtime
# If you want to override, uncomment and set:
# SERVER_PUBLIC_IP=199.68.217.31